{
  "name": "clipdiff-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm run css",
    "css": "tailwindcss -i assets/styles/source.css -o assets/styles/main.css --minify",
    "css:watch": "tailwindcss -i assets/styles/source.css -o assets/styles/main.css --watch",
    "preview": "node scripts/serve.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
